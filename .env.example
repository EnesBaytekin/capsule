# JWT Secret - CHANGE THIS IN PRODUCTION
# Generate a strong random secret key
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Whitelist Settings
# Enable username whitelist for registration (set to "true" or "false")
# When enabled, only usernames in the whitelist file can register
USE_WHITELIST=false

# Path to the whitelist file (one username per line, # for comments)
# - For local development: ./config/whitelist.txt
# - For Docker: /app/config/whitelist.txt (automatically set in docker-compose.yml)
# File will be automatically reloaded when changed without requiring restart
WHITELIST_FILE=./config/whitelist.txt
