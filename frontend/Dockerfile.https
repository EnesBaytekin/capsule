# Frontend with HTTPS support using nginx
FROM alpine:latest

# Install nginx and python3
RUN apk add --no-cache nginx python3

WORKDIR /app

# Copy static files
COPY static /usr/share/nginx/html

# Copy nginx configuration
COPY nginx.conf /etc/nginx/nginx.conf

# Copy HTTPS startup script
COPY https-entrypoint.sh /app/https-entrypoint.sh
RUN chmod +x /app/https-entrypoint.sh

# Expose ports
EXPOSE 3000 3443

# Start script to handle both HTTP and HTTPS
CMD ["/app/https-entrypoint.sh"]
